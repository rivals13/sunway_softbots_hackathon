def load_bipad_districts(
    session: requests.Session,
) -> Tuple[
    Dict[int, Dict[str, Any]],
    Dict[str, int]
]:

    print("\nFetching BIPAD districts...")

    payload = get_json(
        session,
        BIPAD_DISTRICT_URL,
        params={
            "limit": 100
        },
    )

    records = records_from_payload(
        payload
    )

    by_id = {}
    by_name = {}

    for rec in records:

        try:

            district_id = int(
                rec.get("id")
            )

        except (
            TypeError,
            ValueError,
        ):

            continue

        name = (
            rec.get("title")
            or rec.get("name")
            or rec.get("district")
        )

        if not name:
            continue

        by_id[district_id] = rec

        by_name[
            normalize_name(name)
        ] = district_id

    print(
        f"BIPAD districts loaded: "
        f"{len(by_id)}"
    )

    return by_id, by_name


# =============================================================================
# GEOJSON → BIPAD DISTRICT MAPPING
# =============================================================================

def build_geo_to_bipad_mapping(
    geo_districts: List[Dict[str, Any]],
    bipad_by_id: Dict[int, Dict[str, Any]],
    bipad_by_name: Dict[str, int],
) -> Dict[int, int]:

    print(
        "\nMapping GeoJSON districts "
        "to BIPAD district IDs..."
    )

    mapping = {}

    for geo in geo_districts:

        geo_id = geo["district_id"]

        name = geo["district"]

        if geo_id in bipad_by_id:

            mapping[geo_id] = geo_id

            continue

        norm = normalize_name(name)

        if norm in bipad_by_name:

            mapping[geo_id] = (
                bipad_by_name[norm]
            )

            continue

        compact_geo = re.sub(
            r"[^a-z0-9]",
            "",
            norm,
        )

        compact_matches = []

        for (
            bipad_name,
            bipad_id,
        ) in bipad_by_name.items():

            compact_bipad = re.sub(
                r"[^a-z0-9]",
                "",
                bipad_name,
            )

            if (
                compact_geo
                == compact_bipad
            ):

                compact_matches.append(
                    bipad_id
                )

        if len(compact_matches) == 1:

            mapping[geo_id] = (
                compact_matches[0]
            )

    print(
        f"Successfully mapped: "
        f"{len(mapping)} / "
        f"{len(geo_districts)}"
    )

    for geo in geo_districts:

        if (
            geo["district_id"]
            not in mapping
        ):

            print(
                "UNMAPPED DISTRICT: "
                f"{geo['district']} | "
                f"Geo ID "
                f"{geo['district_id']}"
            )

    return mapping


# =============================================================================
# COORDINATES
# =============================================================================

def record_coordinates(
    record: Dict[str, Any],
) -> Optional[Tuple[float, float]]:

    for container_key in (
        "point",
        "geometry",
    ):

        container = record.get(
            container_key
        )

        if not isinstance(
            container,
            dict,
        ):
            continue

        coords = container.get(
            "coordinates"
        )

        if (
            isinstance(
                coords,
                (list, tuple),
            )
            and len(coords) >= 2
        ):

            lon = safe_float(
                coords[0]
            )

            lat = safe_float(
                coords[1]
            )

            if (
                lon is not None
                and lat is not None
            ):

                return lon, lat

    return None


# =============================================================================
# FRESHNESS
# =============================================================================

def get_age_minutes(
    observed: Optional[datetime],
    now: datetime,
) -> Optional[float]:

    if observed is None:
        return None

    return max(
        0.0,
        (
            now - observed
        ).total_seconds() / 60,
    )


def is_fresh(
    observed: Optional[datetime],
    now: datetime,
    threshold_minutes: int,
) -> bool:

    age = get_age_minutes(
        observed,
        now,
    )

    if age is None:
        return False

    return age <= threshold_minutes


def freshness_status(
    observed: Optional[datetime],
    now: datetime,
    threshold_minutes: int,
) -> Dict[str, Any]:

    if observed is None:

        return {
            "observed_at_utc": None,
            "age_minutes": None,
            "status": "NO DATA",
        }

    age = get_age_minutes(
        observed,
        now,
    )

    if age is None:

        return {
            "observed_at_utc": iso(observed),
            "age_minutes": None,
            "status": "NO DATA",
        }

    if age <= threshold_minutes:

        status = "FRESH"

    else:

        status = "STALE"

    return {
        "observed_at_utc": iso(observed),
        "age_minutes": round(
            age,
            1,
        ),
        "status": status,
    }


# =============================================================================
# BIPAD RAINFALL
# =============================================================================

def extract_rain_1h(
    record: Dict[str, Any],
) -> Optional[float]:

    # Direct fields first.

    for key in (
        "rainfall",
        "rain",
        "rain_1h",
        "rainfall1h",
        "value",
        "amount",
        "precipitation",
    ):

        value = safe_float(
            record.get(key)
        )

        if value is not None:
            return value

    # Some BIPAD payloads contain averages.

    averages = record.get(
        "averages"
    )

    if isinstance(
        averages,
        list,
    ):

        for avg in averages:

            if not isinstance(
                avg,
                dict,
            ):
                continue

            try:

                interval = int(
                    avg.get("interval")
                )

            except (
                TypeError,
                ValueError,
            ):

                continue

            if interval == 1:

                for key in (
                    "value",
                    "average",
                    "rainfall",
                    "amount",
                ):

                    value = safe_float(
                        avg.get(key)
                    )

                    if value is not None:
                        return value

    return None


def extract_rain_time(
    record: Dict[str, Any],
) -> Optional[datetime]:

    return parse_dt(
        record.get("measuredOn")
        or record.get("measured_on")
        or record.get("observedAt")
        or record.get("observed_at")
        or record.get("time")
        or record.get("rainfallOn")
    )


def fetch_bipad_rain(
    session: requests.Session,
    geo_districts: List[Dict[str, Any]],
    bipad_by_id: Dict[int, Dict[str, Any]],
    bipad_by_name: Dict[str, int],
    now: datetime,
) -> Tuple[
    Dict[int, Dict[str, Any]],
    Optional[datetime],
    int,
    int,
    int,
]:

    print(
        "\nFetching BIPAD REALTIME rainfall..."
    )

    params = {
        "latest": "true",
        "limit": 1000,
    }

    try:

        records = fetch_all_pages(
            session,
            BIPAD_RAIN_URL,
            params=params,
            max_pages=20,
        )

    except Exception as exc:

        print(
            "BIPAD realtime rainfall "
            f"failed: {exc}"
        )

        return (
            {},
            None,
            0,
            0,
            0,
        )

    latest_by_station = {}

    invalid = 0
    stale = 0

    for rec in records:

        measured = extract_rain_time(
            rec
        )

        rain = extract_rain_1h(
            rec
        )

        if (
            measured is None
            or rain is None
        ):

            invalid += 1

            continue

        station_key = (
            rec.get("stationSeriesId")
            or rec.get("station")
            or rec.get("id")
            or rec.get("title")
            or str(
                record_coordinates(rec)
            )
        )

        old = latest_by_station.get(
            station_key
        )

        if (
            old is None
            or measured > old["_dt"]
        ):

            copy = dict(rec)

            copy["_dt"] = measured
            copy["_rain"] = rain

            latest_by_station[
                station_key
            ] = copy

    district_data = {}

    mapped_id = 0
    mapped_name = 0
    mapped_coord = 0
    unmapped = 0

    latest_time = None

    for rec in latest_by_station.values():

        observed = rec["_dt"]

        # Track latest observation even if stale.
        if (
            latest_time is None
            or observed > latest_time
        ):

            latest_time = observed

        # IMPORTANT:
        # stale observations are retained only
        # as source statistics, not current evidence.

        if not is_fresh(
            observed,
            now,
            BIPAD_FRESH_MINUTES,
        ):

            stale += 1

            continue

        district_id = None

        # ---------------------------------------------------------------------
        # DISTRICT ID
        # ---------------------------------------------------------------------

        try:

            raw_id = int(
                rec.get("district")
            )

            if raw_id in bipad_by_id:

                district_id = raw_id

                mapped_id += 1

        except (
            TypeError,
            ValueError,
        ):

            pass

        # ---------------------------------------------------------------------
        # DISTRICT NAME
        # ---------------------------------------------------------------------

        if district_id is None:

            for key in (
                "districtName",
                "district_name",
                "districtTitle",
                "district_title",
            ):

                name = rec.get(key)

                if not name:
                    continue

                norm = normalize_name(
                    name
                )

                if norm in bipad_by_name:

                    district_id = (
                        bipad_by_name[norm]
                    )

                    mapped_name += 1

                    break

        # ---------------------------------------------------------------------
        # COORDINATES
        # ---------------------------------------------------------------------

        if district_id is None:

            coords = record_coordinates(
                rec
            )

            if coords:

                point = Point(
                    coords[0],
                    coords[1],
                )

                for geo in geo_districts:

                    if geo[
                        "prepared"
                    ].contains(point):

                        district_id = (
                            geo["district_id"]
                        )

                        mapped_coord += 1

                        break

        if district_id is None:

            unmapped += 1

            continue

        rain = rec["_rain"]

        district = district_data.setdefault(
            district_id,
            {
                "max_1h": None,
                "station_count": 0,
                "latest_observed_at": None,
                "stations": [],
            },
        )

        district[
            "station_count"
        ] += 1

        if (
            district["max_1h"] is None
            or rain > district["max_1h"]
        ):

            district["max_1h"] = rain

        current_latest = parse_dt(
            district[
                "latest_observed_at"
            ]
        )

        if (
            current_latest is None
            or observed > current_latest
        ):

            district[
                "latest_observed_at"
            ] = iso(observed)

        station_name = (
            rec.get("stationTitle")
            or rec.get("stationName")
            or rec.get("title")
            or rec.get("station")
        )

        district[
            "stations"
        ].append(
            {
                "station": station_name,
                "rain_1h_mm": rain,
                "observed_at": iso(
                    observed
                ),
                "age_minutes": round(
                    get_age_minutes(
                        observed,
                        now,
                    ),
                    1,
                ),
                "freshness": "FRESH",
                "station_series_id":
                    rec.get(
                        "stationSeriesId"
                    ),
                "source":
                    rec.get(
                        "dataSource"
                    )
                    or "BIPAD/DHM",
            }
        )

    valid = sum(
        len(x["stations"])
        for x in district_data.values()
    )

    print(
        f"Rain records received: "
        f"{len(records)}"
    )

    print(
        f"Latest unique rain stations: "
        f"{len(latest_by_station)}"
    )

    print(
        f"Fresh rain stations used: "
        f"{valid}"
    )

    print(
        f"Stale rain stations excluded: "
        f"{stale}"
    )

    print(
        f"Rain invalid records: "
        f"{invalid}"
    )

    print(
        f"Rain mapped by district ID: "
        f"{mapped_id}"
    )

    print(
        f"Rain mapped by district name: "
        f"{mapped_name}"
    )

    print(
        f"Rain mapped by coordinates: "
        f"{mapped_coord}"
    )

    print(
        f"Rain unmapped: "
        f"{unmapped}"
    )

    return (
        district_data,
        latest_time,
        len(records),
        invalid,
        stale,
    )


