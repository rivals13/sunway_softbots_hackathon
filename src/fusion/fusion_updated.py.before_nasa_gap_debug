def contiguous_accumulation(
    series: List[Dict[str, Any]],
    steps: int,
) -> Tuple[
    Optional[float],
    int,
]:

    if len(series) < steps:

        return None, 0

    ordered = sorted(
        series,
        key=lambda x: x["end"],
    )

    latest = ordered[
        -steps:
    ]

    parsed = []

    for item in latest:

        dt = parse_dt(
            item["end"]
        )

        value = safe_float(
            item.get("mm")
        )

        if (
            dt is None
            or value is None
        ):

            return None, 0

        parsed.append(
            (
                dt,
                value,
            )
        )

    for i in range(
        1,
        len(parsed),
    ):

        delta = (
            parsed[i][0]
            - parsed[i - 1][0]
        )

        if abs(
            delta.total_seconds()
            - 1800
        ) > 5:

            return None, 0

    return (
        float(
            sum(
                v
                for _, v
                in parsed
            )
        ),
        len(parsed),
    )


def calculate_nasa_metrics(
    series: List[Dict[str, Any]],
) -> Dict[str, Any]:

    requested = {
        "nasa_30min_mm": 1,
        "nasa_1h_mm": 2,
        "nasa_3h_mm": 6,
        "nasa_6h_mm": 12,
        "nasa_12h_mm": 24,
        "nasa_24h_mm": 48,
        "nasa_3day_mm": 144,
        "nasa_5day_mm": 240,
        "nasa_7day_mm": 336,
    }

    metrics = {}

    for key, steps in requested.items():

        value, used = (
            contiguous_accumulation(
                series,
                steps,
            )
        )

        metrics[key] = value

        metrics[
            key.replace(
                "_mm",
                "_timesteps",
            )
        ] = used

    ordered = sorted(
        series,
        key=lambda x: x["end"],
    )

    coverage_hours = 0.0
    gaps = 0

    if ordered:

        first_start = parse_dt(
            ordered[0]["start"]
        )

        last_end = parse_dt(
            ordered[-1]["end"]
        )

        if (
            first_start
            and last_end
        ):

            coverage_hours = max(
                0.0,
                (
                    last_end
                    - first_start
                ).total_seconds()
                / 3600,
            )

        for i in range(
            1,
            len(ordered),
        ):

            a = parse_dt(
                ordered[
                    i - 1
                ]["end"]
            )

            b = parse_dt(
                ordered[i]["end"]
            )

            if a and b:

                if abs(
                    (
                        b - a
                    ).total_seconds()
                    - 1800
                ) > 5:

                    gaps += 1

    metrics[
        "nasa_available_timesteps"
    ] = len(series)

    metrics[
        "nasa_available_coverage_hours"
    ] = round(
        coverage_hours,
        3,
    )

    metrics[
        "nasa_gap_count"
    ] = gaps

    return metrics


