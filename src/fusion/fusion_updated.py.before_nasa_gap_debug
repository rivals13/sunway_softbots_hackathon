def load_geojson() -> Tuple[
    List[Dict[str, Any]],
    Dict[int, Dict[str, Any]]
]:

    print("Loading GeoJSON districts...")

    with GEOJSON_PATH.open(
        "r",
        encoding="utf-8",
    ) as f:

        geo = json.load(f)

    features = geo.get(
        "features",
        [],
    )

    districts = []
    by_id = {}

    next_district_id = 1

    for feature in features:

        props = feature.get(
            "properties",
            {},
        )

        geom = feature.get(
            "geometry"
        )

        if not geom:
            continue

        name = (
            props.get("adm2_name")
            or props.get("NAME_2")
            or props.get("name")
            or f"District {next_district_id}"
        )

        pcode = (
            props.get("adm2_pcode")
            or props.get("GID_2")
        )

        district_id = next_district_id

        next_district_id += 1

        geom_shape = shape(geom)

        record = {
            "district_id": district_id,
            "district": str(name),
            "pcode": pcode,
            "geometry": geom_shape,
            "prepared": prep(geom_shape),
        }

        districts.append(record)

        by_id[district_id] = record

    print(
        f"GeoJSON districts loaded: "
        f"{len(districts)}"
    )

    return districts, by_id


