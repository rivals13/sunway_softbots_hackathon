def extract_river_time(
    record: Dict[str, Any],
) -> Optional[datetime]:

    return parse_dt(
        record.get("waterLevelOn")
        or record.get("water_level_on")
        or record.get("observedAt")
        or record.get("observed_at")
        or record.get("time")
    )


def extract_water_level(
    record: Dict[str, Any],
) -> Optional[float]:

    return safe_float(
        record.get("waterLevel")
        if record.get("waterLevel")
        is not None
        else record.get(
            "water_level"
        )
    )


