                "districtTitle",
                "district_title",
            ):

                name = rec.get(key)

                if not name:
                    continue

                norm = normalize_name(
                    name
                )

                if norm in bipad_by_name:

                    district_id = (
                        bipad_by_name[norm]
                    )

                    mapped_name += 1

                    break

        # ---------------------------------------------------------------------
        # COORDINATES
        # ---------------------------------------------------------------------

        if district_id is None:

            coords = record_coordinates(
                rec
            )

            if coords:

                point = Point(
                    coords[0],
                    coords[1],
                )

                for geo in geo_districts:

                    if geo[
                        "prepared"
                    ].contains(point):

                        district_id = (
                            geo["district_id"]
                        )

                        mapped_coord += 1

                        break

        if district_id is None:

            unmapped += 1

            continue

        # ---------------------------------------------------------------------
        # THRESHOLDS
        # ---------------------------------------------------------------------

        warning = safe_float(
            rec.get("warningLevel")
            if rec.get("warningLevel")
            is not None
            else rec.get(
                "warning_level"
            )
        )

        danger = safe_float(
            rec.get("dangerLevel")
            if rec.get("dangerLevel")
            is not None
            else rec.get(
                "danger_level"
            )
        )

        threshold_valid = True

        # Example bad BIPAD record:
        #
        # warning = 125
        # danger  = 122.5
        #
        # That is physically/logically invalid
        # because danger must be >= warning.

        if (
            warning is not None
            and danger is not None
            and danger < warning
        ):

            warning = None
            danger = None

            threshold_invalid += 1

            threshold_valid = False

        status = (
            rec.get("status")
            or rec.get(
                "waterLevelStatus"
            )
            or rec.get(
                "water_level_status"
            )
        )

        trend = (
            rec.get("steady")
            or rec.get("trend")
            or rec.get(
                "waterLevelTrend"
            )
        )

        station = (
            rec.get("title")
            or rec.get(
                "stationTitle"
            )
            or rec.get(
                "stationName"
            )
            or rec.get("station")
        )

        district = district_data.setdefault(
            district_id,
            {
                "stations": [],
                "warning_station_count": 0,
                "danger_station_count": 0,
                "rising_station_count": 0,
                "latest_observed_at": None,
            },
        )

        # ---------------------------------------------------------------------
        # THRESHOLD COUNTS
        # ---------------------------------------------------------------------

        if (
            warning is not None
            and danger is not None
        ):

            if water >= danger:

                district[
                    "danger_station_count"
                ] += 1

            elif water >= warning:

                district[
                    "warning_station_count"
                ] += 1

        # ---------------------------------------------------------------------
        # TREND
        # ---------------------------------------------------------------------

        if (
            trend
            and str(trend).upper()
            == "RISING"
        ):

            district[
                "rising_station_count"
            ] += 1

        # ---------------------------------------------------------------------
        # LATEST OBSERVATION
        # ---------------------------------------------------------------------

        current_latest = parse_dt(
            district[
                "latest_observed_at"
            ]
        )

        if (
            current_latest is None
            or observed > current_latest
        ):

            district[
                "latest_observed_at"
            ] = iso(observed)

        # ---------------------------------------------------------------------
        # UTILIZATION
        # ---------------------------------------------------------------------

        warning_utilization = None
        danger_utilization = None

        if (
            warning is not None
            and warning > 0
        ):

            warning_utilization = (
                water / warning
            )

        if (
            danger is not None
            and danger > 0
        ):

            danger_utilization = (
                water / danger
            )

        district[
            "stations"
        ].append(
            {
                "station": station,
                "point": rec.get("point"),
                "water_level_m": water,
                "warning_level_m": warning,
                "danger_level_m": danger,
                "warning_utilization":
                    warning_utilization,
                "danger_utilization":
                    danger_utilization,
                "status": status,
                "trend": trend,
                "observed_at":
                    iso(observed),
                "age_minutes":
                    round(
                        get_age_minutes(
                            observed,
                            now,
                        ),
                        1,
                    ),
                "freshness":
                    "FRESH",
                "thresholds_valid":
                    threshold_valid,
                "station_series_id":
                    rec.get(
                        "stationSeriesId"
                    ),
                "source":
                    rec.get(
                        "dataSource"
                    )
                    or "BIPAD/DHM",
            }
        )

    valid = sum(
        len(x["stations"])
        for x in district_data.values()
    )

    print(
        f"River records received: "
        f"{len(records)}"
    )

    print(
        f"Unique river stations: "
        f"{len(latest_by_station)}"
    )

    print(
        f"Fresh river stations used: "
        f"{valid}"
    )

    print(
        f"Stale river stations excluded: "
        f"{stale}"
    )

    print(
        f"River invalid records: "
        f"{invalid}"
    )

    print(
        f"River mapped by district ID: "
        f"{mapped_id}"
    )

    print(
        f"River mapped by district name: "
        f"{mapped_name}"
    )

    print(
        f"River mapped by coordinates: "
        f"{mapped_coord}"
    )

    print(
        f"River unmapped: "
        f"{unmapped}"
    )

    warning_observations = sum(
        1
        for d in district_data.values()
        for s in d["stations"]
        if s["warning_level_m"]
        is not None
    )

    danger_observations = sum(
        1
        for d in district_data.values()
        for s in d["stations"]
        if s["danger_level_m"]
        is not None
    )

    rising = sum(
        1
        for d in district_data.values()
        for s in d["stations"]
        if str(
            s.get("trend", "")
        ).upper()
        == "RISING"
    )

    unique_warning = len(
        {
            s.get(
                "station_series_id"
            )
            or s.get("station")
            for d in district_data.values()
            for s in d["stations"]
            if s[
                "warning_level_m"
            ] is not None
        }
    )

    unique_danger = len(
        {
            s.get(
                "station_series_id"
            )
            or s.get("station")
            for d in district_data.values()
            for s in d["stations"]
            if s[
                "danger_level_m"
            ] is not None
        }
    )

    print(
        "River observations with "
        f"warning threshold: "
        f"{warning_observations}"
    )

    print(
        "River observations with "
        f"danger threshold: "
        f"{danger_observations}"
    )

    print(
        "Unique stations with "
        f"warning threshold: "
        f"{unique_warning}"
    )

    print(
        "Unique stations with "
        f"danger threshold: "
        f"{unique_danger}"
    )

    print(
        f"Rising river stations: "
        f"{rising}"
    )

    print(
        f"Invalid threshold records: "
        f"{threshold_invalid}"
    )

    return (
        district_data,
        latest_time,
        len(records),
        invalid,
        stale,
    )


