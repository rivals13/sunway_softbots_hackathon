def parse_nasa_filename(
    filename: str,
) -> Optional[Dict[str, Any]]:

    name = filename.split("/")[-1]

    match = re.search(
        r"3IMERG\.(\d{8})-S(\d{6})-E(\d{6})",
        name,
        re.IGNORECASE,
    )

    if not match:
        return None

    date_text, start_text, end_text = (
        match.groups()
    )

    try:

        start_dt = datetime.strptime(
            date_text + start_text,
            "%Y%m%d%H%M%S",
        ).replace(
            tzinfo=timezone.utc
        )

        end_dt = datetime.strptime(
            date_text + end_text,
            "%Y%m%d%H%M%S",
        ).replace(
            tzinfo=timezone.utc
        )

    except ValueError:

        return None

    if end_dt < start_dt:
        end_dt += timedelta(days=1)

    lower = name.lower()

    if (
        ".3hr." in lower
        or ".1day." in lower
    ):
        return None

    if "3b-hhr-e" not in lower:
        return None

    return {
        "filename": name,
        "start": start_dt,
        "end": end_dt,
    }


def discover_nasa_files(
    session: requests.Session,
    start: datetime,
    end: datetime,
) -> List[Dict[str, Any]]:

    print(
        "\nDiscovering NASA IMERG "
        "Early Run files..."
    )

    months = []

    cursor = datetime(
        start.year,
        start.month,
        1,
        tzinfo=timezone.utc,
    )

    final_month = datetime(
        end.year,
        end.month,
        1,
        tzinfo=timezone.utc,
    )

    while cursor <= final_month:

        months.append(
            (
                cursor.year,
                cursor.month,
            )
        )

        if cursor.month == 12:

            cursor = datetime(
                cursor.year + 1,
                1,
                1,
                tzinfo=timezone.utc,
            )

        else:

            cursor = datetime(
                cursor.year,
                cursor.month + 1,
                1,
                tzinfo=timezone.utc,
            )

    discovered = {}

    auth = (
        (NASA_USER, NASA_PASS)
        if NASA_USER and NASA_PASS
        else None
    )

    for year, month in months:

        url = NASA_BASE.format(
            year=year,
            month=month,
        )

        try:

            response = session.get(
                url,
                auth=auth,
                timeout=REQUEST_TIMEOUT,
            )

            response.raise_for_status()

        except Exception as exc:

            print(
                f"NASA directory failed: "
                f"{url}"
            )

            print(
                f"Reason: {exc}"
            )

            continue

        links = re.findall(
            r'href=["\']([^"\']+\.tif)["\']',
            response.text,
            flags=re.IGNORECASE,
        )

        if not links:

            links = re.findall(
                r'([A-Za-z0-9_.-]+\.tif)',
                response.text,
                flags=re.IGNORECASE,
            )

        for link in links:

            filename = (
                link.split("/")[-1]
            )

            info = parse_nasa_filename(
                filename
            )

            if not info:
                continue

            if info["end"] < start:
                continue

            if info["start"] > end:
                continue

            discovered[
                filename
            ] = info

    files = sorted(
        discovered.values(),
        key=lambda x: x["start"],
    )

    print(
        "NASA files discovered in "
        f"history window: {len(files)}"
    )

    return files


def download_nasa_file(
    session: requests.Session,
    info: Dict[str, Any],
) -> Optional[bytes]:

    filename = info["filename"]

    url = (
        "https://jsimpsonhttps.pps.eosdis.nasa.gov/"
        "imerg/gis/early/"
        f"{info['start'].year:04d}/"
        f"{info['start'].month:02d}/"
        f"{filename}"
    )

    auth = (
        (NASA_USER, NASA_PASS)
        if NASA_USER and NASA_PASS
        else None
    )

    try:

        response = session.get(
            url,
            auth=auth,
            timeout=REQUEST_TIMEOUT,
        )

        response.raise_for_status()

        return response.content

    except Exception as exc:

        print(
            f"NASA download failed: "
            f"{filename}"
        )

        print(
            f"Reason: {exc}"
        )

        return None


def get_raster_window_from_bytes(
    raw: bytes,
    bbox: Tuple[
        float,
        float,
        float,
        float,
    ],
) -> Optional[np.ndarray]:

    try:

        import rasterio

        from rasterio.io import MemoryFile

    except ImportError:

        print(
            "ERROR: rasterio is required "
            "for NASA GeoTIFF processing."
        )

        return None

    try:

        with MemoryFile(raw) as mem:

            with mem.open() as src:

                window = (
                    rasterio.windows.from_bounds(
                        bbox[0],
                        bbox[1],
                        bbox[2],
                        bbox[3],
                        transform=src.transform,
                    )
                )

                window = (
                    window
                    .round_offsets()
                    .round_lengths()
                )

                arr = src.read(
                    1,
                    window=window,
                ).astype(float)

                if src.nodata is not None:

                    arr[
                        arr == src.nodata
                    ] = np.nan

                arr[
                    arr >= 29999
                ] = np.nan

                # NASA IMERG GIS rainfall
                # is represented in tenths of mm.

                arr = arr / 10.0

                return arr

    except Exception as exc:

        print(
            "NASA GeoTIFF processing "
            f"failed: {exc}"
        )

        return None


def district_masks_for_raster(
    geo_districts: List[Dict[str, Any]],
    raster_shape: Tuple[int, int],
    bbox: Tuple[
        float,
        float,
        float,
        float,
    ],
) -> Dict[int, np.ndarray]:

    rows, cols = raster_shape

    min_lon, min_lat, max_lon, max_lat = (
        bbox
    )

    lons = (
        np.linspace(
            min_lon,
            max_lon,
            cols,
            endpoint=False,
        )
        + (
            max_lon - min_lon
        ) / cols / 2
    )

    lats = (
        np.linspace(
            max_lat,
            min_lat,
            rows,
            endpoint=False,
        )
        - (
            max_lat - min_lat
        ) / rows / 2
    )

    lon_grid, lat_grid = np.meshgrid(
        lons,
        lats,
    )

    masks = {}

    for geo in geo_districts:

        district_id = geo[
            "district_id"
        ]

        prepared = geo[
            "prepared"
        ]

        mask = np.zeros(
            (
                rows,
                cols,
            ),
            dtype=bool,
        )

        for r in range(rows):

            for c in range(cols):

                if prepared.contains(
                    Point(
                        lon_grid[r, c],
                        lat_grid[r, c],
                    )
                ):

                    mask[
                        r,
                        c
                    ] = True

        masks[
            district_id
        ] = mask

    return masks


def process_nasa_files(
    session: requests.Session,
    nasa_files: List[Dict[str, Any]],
    geo_districts: List[Dict[str, Any]],
) -> Tuple[
    Dict[int, List[Dict[str, Any]]],
    Optional[datetime],
    int,
    int,
]:

    print(
        "\nProcessing NASA IMERG files..."
    )

    nasa_series = {
        geo["district_id"]: []
        for geo in geo_districts
    }

    if not nasa_files:

        return (
            nasa_series,
            None,
            0,
            0,
        )

    bbox = (
        80.0,
        26.0,
        89.0,
        31.5,
    )

    latest_end = None

    processed = 0
    failed = 0

    masks = None

    for index, info in enumerate(
        nasa_files,
        start=1,
    ):

        print(
            f"  [{index}/{len(nasa_files)}] "
            f"{info['filename']}"
        )

        raw = download_nasa_file(
            session,
            info,
        )

        if raw is None:

            failed += 1

            continue

        arr = (
            get_raster_window_from_bytes(
                raw,
                bbox,
            )
        )

        if (
            arr is None
            or arr.size == 0
        ):

            failed += 1

            continue

        if masks is None:

            print(
                "NASA Nepal raster window: "
                f"{arr.shape[1]} x "
                f"{arr.shape[0]}"
            )

            masks = (
                district_masks_for_raster(
                    geo_districts,
                    arr.shape,
                    bbox,
                )
            )

            print(
                "District masks built: "
                f"{len(masks)}"
            )

        for (
            district_id,
            mask,
        ) in masks.items():

            values = arr[mask]

            values = values[
                np.isfinite(values)
            ]

            district_mean = (
                float(
                    np.mean(values)
                )
                if values.size
                else None
            )

            nasa_series[
                district_id
            ].append(
                {
                    "start": iso(
                        info["start"]
                    ),
                    "end": iso(
                        info["end"]
                    ),
                    "mm": district_mean,
                }
            )

        processed += 1

        if (
            latest_end is None
            or info["end"] > latest_end
        ):

            latest_end = info["end"]

    populated = sum(
        1
        for values
        in nasa_series.values()
        if values
    )

    print(
        f"NASA files processed: "
        f"{processed}"
    )

    print(
        f"NASA files failed: "
        f"{failed}"
    )

    print(
        "NASA districts populated: "
        f"{populated} / "
        f"{len(geo_districts)}"
    )

    return (
        nasa_series,
        latest_end,
        processed,
        failed,
    )


