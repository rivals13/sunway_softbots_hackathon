def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def parse_dt(value: Any) -> Optional[datetime]:
    if value is None:
        return None

    text = str(value).strip()

    if not text:
        return None

    if text.endswith("Z"):
        text = text[:-1] + "+00:00"

    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        dt = None

        for fmt in (
            "%Y-%m-%dT%H:%M:%S.%f",
            "%Y-%m-%dT%H:%M:%S",
            "%Y-%m-%d %H:%M:%S",
        ):
            try:
                dt = datetime.strptime(text, fmt)
                break
            except ValueError:
                pass

        if dt is None:
            return None

    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)

    return dt.astimezone(timezone.utc)


def iso(dt: Optional[datetime]) -> Optional[str]:
    return dt.isoformat() if dt else None


def normalize_name(value: Any) -> str:
    if value is None:
        return ""

    s = str(value).strip().lower()

    s = s.replace("district", "")
    s = s.replace("-", " ")
    s = s.replace("_", " ")

    s = re.sub(r"[^a-z0-9 ]+", "", s)
    s = re.sub(r"\s+", " ", s).strip()

    aliases = {
        "chitawan": "chitwan",
        "tehrathum": "terhathum",
        "terathum": "terhathum",
        "sindhupalchowk": "sindhupalchok",
        "dhanusha": "dhanusa",
        "tanahun": "tanahu",
        "kapilvastu": "kapilbastu",
        "ktm": "kathmandu",
        "kavre": "kavrepalanchok",
        "kavrepalanchowk": "kavrepalanchok",
        "rukumeast": "rukum east",
        "rukum east": "rukum east",
        "rukumwest": "rukum west",
        "rukum west": "rukum west",
        "nawalparasieast": "nawalparasi east",
        "nawalparasi east": "nawalparasi east",
        "nawalparasiwest": "nawalparasi west",
        "nawalparasi west": "nawalparasi west",
    }

    return aliases.get(s, s)


def safe_float(value: Any) -> Optional[float]:
    if value is None or value == "":
        return None

    try:
        x = float(value)

        if np.isfinite(x):
            return x

        return None

    except (TypeError, ValueError):
        return None


def get_json(
    session: requests.Session,
    url: str,
    params: Optional[Dict[str, Any]] = None,
    auth: Optional[Tuple[str, str]] = None,
) -> Any:

    last_error = None

    for attempt in range(1, MAX_RETRIES + 1):

        try:

            response = session.get(
                url,
                params=params,
                auth=auth,
                timeout=REQUEST_TIMEOUT,
            )

            if response.status_code >= 400:

                print(
                    f"HTTP {response.status_code}: "
                    f"{response.url}"
                )

                print(response.text[:500])

            response.raise_for_status()

            return response.json()

        except Exception as exc:

            last_error = exc

            if attempt < MAX_RETRIES:

                wait = 2 ** (attempt - 1)

                print(
                    f"Request failed "
                    f"(attempt {attempt}/{MAX_RETRIES}): "
                    f"{exc}"
                )

                print(
                    f"Retrying in {wait}s..."
                )

                time.sleep(wait)

    raise RuntimeError(
        f"Request failed after "
        f"{MAX_RETRIES} attempts: "
        f"{last_error}"
    )


def records_from_payload(
    payload: Any,
) -> List[Dict[str, Any]]:

    if isinstance(payload, list):
        return [
            x for x in payload
            if isinstance(x, dict)
        ]

    if isinstance(payload, dict):

        for key in (
            "results",
            "data",
            "features",
            "items",
        ):

            value = payload.get(key)

            if isinstance(value, list):

                return [
                    x for x in value
                    if isinstance(x, dict)
                ]

    return []


# =============================================================================
# PAGINATION
# =============================================================================

def fetch_all_pages(
    session: requests.Session,
    url: str,
    params: Optional[Dict[str, Any]] = None,
    auth: Optional[Tuple[str, str]] = None,
    max_pages: int = 20,
) -> List[Dict[str, Any]]:

    base_params = dict(params or {})

    all_records: List[Dict[str, Any]] = []

    next_url = url
    next_params = base_params

    for page_number in range(1, max_pages + 1):

        payload = get_json(
            session,
            next_url,
            params=next_params,
            auth=auth,
        )

        page_records = records_from_payload(payload)

        all_records.extend(page_records)

        if not isinstance(payload, dict):
            break

        next_link = payload.get("next")

        if not next_link:
            break

        if not isinstance(next_link, str):
            break

        next_url = next_link

        # The API's next URL already contains its query params.
        next_params = None

    return all_records


